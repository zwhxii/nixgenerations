#!/usr/bin/env bash
set -eu

config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
river_dir=$config_dir/river
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export XCURSOR_THEME=aosp-cursors
export XCURSOR_SIZE=24

apply_bindings() {
    local i tags direction key mode
    local scratch_tag=$((1 << 31))

    riverctl keyboard-layout -options grp:win_space_toggle us,ru
    riverctl xcursor-theme "$XCURSOR_THEME" "$XCURSOR_SIZE"
    riverctl input 'pointer-*' pointer-accel 0
    riverctl input 'pointer-*' natural-scroll disabled
    riverctl border-width 3
    riverctl border-color-focused 0x643e4aff
    riverctl border-color-unfocused 0x595959aa
    riverctl rule-add ssd

    # Resolve keyboard bindings using the US layout (index 0 in us,ru).
    riverctl map -layout 0 normal Super W focus-output next
    riverctl map -layout 0 normal Super+Shift W send-to-output -current-tags next
    riverctl map -layout 0 normal Super Q spawn kitty
    riverctl map -layout 0 normal Super R spawn 'rofi -show drun'
    riverctl map -layout 0 normal Super C close
    riverctl map -layout 0 normal Super M exit
    riverctl map -layout 0 normal Super V toggle-float

    for direction in left right up down; do
        riverctl map -layout 0 normal Super "${direction^}" focus-view "$direction"
        riverctl map -layout 0 normal Super+Shift "${direction^}" swap "$direction"
    done
    riverctl map -layout 0 normal Super+Control Right focus-view next
    riverctl map -layout 0 normal Super+Control Left focus-view previous

    for i in {1..9}; do
        tags=$((1 << (i - 1)))
        riverctl map -layout 0 normal Super "$i" set-focused-tags "$tags"
        riverctl map -layout 0 normal Super+Shift "$i" spawn \
            "riverctl set-view-tags $tags && riverctl set-focused-tags $tags"
        riverctl map -layout 0 normal Super+Alt "$i" toggle-view-tags "$tags"
    done
    riverctl spawn-tagmask 511
    riverctl map -layout 0 normal Super S toggle-focused-tags "$scratch_tag"
    riverctl map -layout 0 normal Super+Shift S set-view-tags "$scratch_tag"

    # The keypad keys have distinct XKB names depending on Num Lock.
    for key in KP_0 KP_Insert; do
        riverctl map -layout 0 normal Super "$key" send-layout-cmd wideriver '--layout top --stack dwindle --count 0'
    done
    for key in KP_1 KP_End; do
        riverctl map -layout 0 normal Super "$key" send-layout-cmd wideriver '--layout left --stack even --count 1'
    done
    for key in KP_2 KP_Down; do
        riverctl map -layout 0 normal Super "$key" send-layout-cmd wideriver '--layout right --stack even --count 1'
    done
    for key in KP_3 KP_Page_Down; do
        riverctl map -layout 0 normal Super "$key" send-layout-cmd wideriver '--layout monocle'
    done

    riverctl map-pointer normal Super BTN_LEFT move-view
    riverctl map-pointer normal Super BTN_RIGHT resize-view
    riverctl map -layout 0 normal None XF86AudioRaiseVolume spawn 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+'
    riverctl map -layout 0 normal None XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
    riverctl map -layout 0 normal None XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
    riverctl map -layout 0 normal None XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
    riverctl map -layout 0 normal None XF86MonBrightnessUp spawn 'brightnessctl -e4 -n2 set 5%+'
    riverctl map -layout 0 normal None XF86MonBrightnessDown spawn 'brightnessctl -e4 -n2 set 5%-'
    for mode in normal locked; do
        riverctl map -layout 0 "$mode" None XF86AudioNext spawn 'playerctl next'
        riverctl map -layout 0 "$mode" None XF86AudioPlay spawn 'playerctl play-pause'
        riverctl map -layout 0 "$mode" None XF86AudioPrev spawn 'playerctl previous'
    done

    riverctl map -layout 0 normal None Print spawn grim
    riverctl map -layout 0 normal Super Tab spawn 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/river/snip"'
    riverctl map -layout 0 normal Super F1 spawn 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/river/init" --reload'
}

apply_bindings
if [[ ${1:-} == --reload ]]; then
    exit 0
fi

wlr-randr --output DP-1 --mode 2560x1440@240.001Hz --pos 0,0 --scale 1 --adaptive-sync enabled || true
wlr-randr --output HDMI-A-1 --mode 1920x1080@74.973Hz --pos 2560,250 --scale 1 --adaptive-sync disabled || true

riverctl default-layout wideriver
wideriver --layout top --stack dwindle --count-master 0 --inner-gaps 0 --outer-gaps 5 \
    --border-width 3 --border-width-monocle 3 --border-color-focused 0x643e4aff \
    --border-color-focused-monocle 0x643e4aff --border-color-unfocused 0x595959aa &

# Publish the Wayland session before starting the portal or other D-Bus clients.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XCURSOR_THEME XCURSOR_SIZE || true
systemctl --user start xdg-desktop-portal.service --ignore-dependencies || true

swaybg -i "$HOME/Pictures/mal01.png" -m fill &
swaync &
"$config_dir/waybar/launch.sh" &
easyeffects &
openrgb &

# Same schedule and temperatures as the Mango user's wlsunset service.
exec wlsunset -S07:00 -T7500 -g1.000000 -s21:30 -t3500
